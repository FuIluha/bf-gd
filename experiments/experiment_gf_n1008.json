{
  "experiment": {
    "modulation": "bpsk",
    "channel_output": "received",
    "codec": {
      "type": "BinaryLdpcCodec",
      "algorithm": "gf",
      "src_dir": "codes",
      "code": "mackay_PEGReg504x1008.json",
      "n_iterations": 1000,
      "llr_type": "float32",
      "decoder_params": {
        "alpha": 1.0,
        "beta": 2.0,
        "gamma": 1.0,
        "eta": 0.01
      }
    }
  },
  "simulation": {
    "n_workers": 128,
    "snr_range": "-3:0.5:3",
    "max_errors": 200,
    "min_error_prob": 1e-7,
    "chunk_size": 10,
    "max_experiments": 10000000,
    "snr_precision": 3,
    "log_file": "log_simulator.log"
  },
  "postprocessing": {
    "confidence_level": 0.95,
    "pe_threshold": 0.95,
    "max_degree": 15,
    "max_degree_ratio": 3,
    "regression_type": "polynomial"
  },
  "visualization": {
    "ip_address": "127.0.0.1",
    "start_port": 8888,
    "update_ms": 5000
  }
}
