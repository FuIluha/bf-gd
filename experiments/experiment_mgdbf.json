{
  "experiment": {
    "modulation": "bpsk",
    "channel_output": "received",
    "codec": {
      "type": "BinaryLdpcCodec",
      "algorithm": "multi gradient descent bit-flipping",
      "src_dir": "codes",
      "code": "ldpc_5g_k120_n600.json",
      "n_iterations": 100,
      "llr_type": "float32",
      "decoder_params": {
        "theta": -0.6,
        "mu": 0
      }
    }
  },
  "simulation": {
    "n_workers": 8,
    "snr_range": "-10:0.05:2",
    "max_errors": 200,
    "min_error_prob": 0.0001,
    "chunk_size": 10,
    "max_experiments": 10000000,
    "snr_precision": 3,
    "log_file": "log_simulator.log"
  },
  "postprocessing": {
    "confidence_level": 0.95,
    "pe_threshold": 0.95,
    "max_degree": 15,
    "max_degree_ratio": 3,
    "regression_type": "polynomial"
  },
  "visualization": {
    "ip_address": "127.0.0.1",
    "start_port": 8888,
    "update_ms": 5000
  }
}
